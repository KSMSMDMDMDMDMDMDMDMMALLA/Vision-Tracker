{
  "name": "face-tracker-electron",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "setup": "node scripts/prepare-mediapipe.mjs",
    "dev": "npm run setup && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build": "npm run setup && vite build",
    "start": "npm run build && electron ."
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "latest"
  },
  "devDependencies": {
    "concurrently": "latest",
    "electron": "latest",
    "vite": "latest",
    "wait-on": "latest"
  }
}
